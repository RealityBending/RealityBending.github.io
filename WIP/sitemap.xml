<?xml version="1.0" encoding="UTF-8"?>
<!--
    One URL, because the site is one document: every deep link into it is a
    hash (#post-…, #dominique-makowski, #join-phd) and a fragment is not an
    address a crawler can index separately. Listing them here would not help —
    a sitemap entry for https://realitybending.github.io/#post-x is read as a
    duplicate of the root and dropped.

    This file is therefore a placeholder for the shape of the site rather than
    a description of its content. It becomes worth something when the news
    posts, people and publications have real paths of their own; at that point
    it should be generated by the update_*.py scripts alongside the manifests,
    not hand-edited.
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
    <url>
        <loc>https://realitybending.github.io/</loc>
        <changefreq>weekly</changefreq>
        <priority>1.0</priority>
    </url>
</urlset>
