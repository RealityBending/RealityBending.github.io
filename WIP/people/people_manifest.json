    {
      "folder": "dominique-makowski",
      "name": "Dominique Makowski",
      "category": "PI",
      "email": "D.Makowski@sussex.ac.uk",
      "details": "Consciousness, perception, and the nature of subjective experience.",
      "website": "https://dominiquemakowski.github.io/",
      "title": "Lecturer in Psychology",
      "affiliation": "University of Sussex",
      "location": "Brighton, UK",
      "summary": "<p>Trained as a clinical neuropsychologist and CBT psychotherapist, Dominique Makowski is a lecturer at the University of Sussex studying how people construct, bend, and experience reality.</p><p>His work spans altered states of consciousness, illusion, deception, fake news, meditation, and immersive experience, with an emphasis on making advanced psychological methods more accessible through <strong>open-source tools</strong>.</p>",
      "socials": [
        {
          "label": "Google Scholar",
          "url": "https://scholar.google.fr/citations?user=bg0BZ-QAAAAJ&hl=en"
        },
        {
          "label": "GitHub",
          "url": "https://github.com/DominiqueMakowski"
        },
        {
          "label": "X",
          "url": "https://x.com/Dom_Makowski"
        },
        {
          "label": "ResearchGate",
          "url": "https://www.researchgate.net/profile/Dominique_Makowski"
        }
      ],
      "interests": [
        "Sense of reality",
        "Emotion regulation",
        "Cognitive control",
        "Clinical neuropsychology",
        "Neuroaesthetics"
      ],
      "education": [
        {
          "degree": "PhD in Psychology",
          "institution": "Universite de Paris",
          "year": "2018",
          "details": "Focused on the neuroscience of reality perception and the mechanisms through which subjective experience can be bent, stabilized, or disrupted."
        },
        {
          "degree": "MSc in Clinical Neuropsychology",
          "institution": "Universite de Paris",
          "year": "2014",
          "details": "Combined clinical assessment, rehabilitation, and therapeutic training with a strong grounding in affective and cognitive neuroscience."
        },
        {
          "degree": "BSc in Psychology",
          "institution": "Universite de Paris",
          "year": "2012",
          "details": "Built the experimental, statistical, and theoretical foundations that later shaped his work on consciousness, perception, and methodology."
        }
      ],
      "keywords": [
        "reality",
        "consciousness",
        "illusion",
        "open science"
      ],
      "hook": "Did you know that Dominique Makowski created the easystats ecosystem for R?",
      "avatar": "people/dominique-makowski/avatar.png"
    },
